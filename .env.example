# ─────────────────────────────────────────────────────────────
# Daybook — copy to .env and fill in. Never commit .env
# ─────────────────────────────────────────────────────────────

# ── api ──────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Postgres. Create the db and role first:
#   sudo -u postgres createuser daybook --pwprompt
#   sudo -u postgres createdb daybook --owner=daybook
DATABASE_URL=postgresql://daybook:CHANGEME@localhost:5432/daybook

# JWT signing key. 32+ random bytes, base64. Generate with:
#   openssl rand -base64 48
# The api MUST refuse to boot if this is missing or under 32 bytes.
JWT_SECRET=

# Cookie domain. Leave blank in development (host-only cookie).
# In production set to the bare domain, e.g. daybook.example
COOKIE_DOMAIN=

# The single allowed origin for CORS. No wildcards, ever.
APP_ORIGIN=http://localhost:5173

# trace | debug | info | warn | error
LOG_LEVEL=debug

# ── web (build-time, must be prefixed VITE_) ─────────────────

VITE_API_BASE=/api
VITE_APP_NAME=Daybook
